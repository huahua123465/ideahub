# 数据库连接串（生产 / 本地开发都用这个）
DATABASE_URL=postgres://postgres:ideahub@localhost:5432/ideahub

# 数据库驱动：pg = 需要 npm i pg（默认）；psql = 走本机 psql 命令行，不用装任何包
DB_DRIVER=pg

# 后端端口
PORT=3000

# 前端静态服务端口（仅开发用）
WEB_PORT=5173

# 会话有效期（天）
SESSION_DAYS=30

# 邀请码。留空 = 开放注册（任何人打开网址都能注册）。
# 公网上如果来了不认识的人，填一个值即可关门，同事注册时要填这个码。
INVITE_CODE=

# cookie 的 Secure 标志：1 强制开，0 强制关，留空 = 自动判断（看是不是 https）
COOKIE_SECURE=

# 智能导入（只在服务端读取，绝对不要写进 web/ 前端文件）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 可选：页面保存的供应商配置使用它加密；留空时从 DATABASE_URL 派生稳定密钥。
AI_CONFIG_SECRET=

# 【开发专用】允许用 X-User-Id 头冒充任何人，接口自测要用。
# 等于「谁都能当管理员」，生产环境务必删掉（NODE_ENV=production 时会自动失效）。
ALLOW_HEADER_AUTH=1

# ── 内容采集 Collector（只在服务器端使用） ──────────────────────────────
# VPS 生成至少 32 字节随机值；IdeaHub api 与 Collector 必须使用同一个值。
# 示例生成命令见 docs/内容采集部署.md。不要把真实值发到聊天或提交到公开仓库。
COLLECTOR_INTERNAL_TOKEN=
# 下列宿主机目录必须位于仓库外，避免 SQLite、Cookie 与媒体被 Git 自动备份。
COLLECTOR_STATE_PATH=/opt/ideahub-collector/state
COLLECTOR_OUTPUT_PATH=/opt/ideahub-collector/output

# 4GB VPS 的安全默认值。昂贵任务和 OCR 在线上固定为单并发，Compose 会再次锁定为 1。
COLLECTOR_MAX_QUEUE=10
COLLECTOR_MAX_VIDEO_SECONDS=600
COLLECTOR_MAX_DOWNLOAD_MB=500
COLLECTOR_DOWNLOAD_TIMEOUT_SEC=600
COLLECTOR_PROCESS_TIMEOUT_SEC=600
COLLECTOR_QR_TTL_SEC=180
COLLECTOR_HTTP_TIMEOUT_SEC=120

# 视频理解 / 文本分析。只填写实际使用的供应商；密钥不会进入浏览器。
VIDEO_MODEL_PROVIDER=moxus
MOXUS_API_KEY=
MOXUS_BASE_URL=https://moxus.ai
MOXUS_VIDEO_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VIDEO_MODEL=stealth/ox-alpha
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：需要语音转文字时填写；不使用可以留空。
OPENAI_WHISPER_KEY=
OPENAI_WHISPER_URL=https://api.openai.com/v1
MODEL_WHISPER=whisper-1

# Collector 把分析结果推回 IdeaHub 的机器密钥（analysis:write scope）。
# 使用现有技术1密钥即可；不要在这里写示例明文。
IDEAHUB_API_KEY=
