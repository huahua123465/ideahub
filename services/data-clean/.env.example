# Copy this file to .env and fill the rotated key locally. Never commit .env.
VIDEO_MODEL_PROVIDER=moxus
MOXUS_API_KEY=
MOXUS_BASE_URL=https://moxus.ai
MOXUS_VIDEO_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VIDEO_MODEL=stealth/ox-alpha
VIDEO_MODEL_CHUNK_SECONDS=60
VIDEO_MODEL_CHUNK_OVERLAP=2
VIDEO_MODEL_FPS=4
VIDEO_MODEL_WIDTH=720
VIDEO_MODEL_MAX_CHUNKS=20
VIDEO_MODEL_REQUEST_RETRIES=3

# IdeaHub 技术1 对接。密钥仅放服务端，不要写进 templates/index.html。
IDEAHUB_API_KEY=
IDEAHUB_INGEST_URL=https://xm.xingxingqule.com:9443/api/ingest/analysis
IDEAHUB_DOC_URL=https://xm.xingxingqule.com:9443/%E6%8E%A5%E5%85%A5%E8%AF%B4%E6%98%8E.html

# IdeaHub -> Collector 内部通信。必须使用至少 32 字节随机值；不要提交真实值。
COLLECTOR_INTERNAL_TOKEN=
COLLECTOR_STATE_DIR=/var/lib/collector/state
COLLECTOR_OUTPUT_DIR=/var/lib/collector/output

# 约 4GB VPS 的保守默认值。
COLLECTOR_MAX_CONCURRENT=1
COLLECTOR_MAX_QUEUE=10
COLLECTOR_OCR_WORKERS=1
COLLECTOR_MAX_VIDEO_SECONDS=600
COLLECTOR_MAX_DOWNLOAD_MB=500
COLLECTOR_DOWNLOAD_TIMEOUT_SEC=600
COLLECTOR_PROCESS_TIMEOUT_SEC=600
COLLECTOR_QR_TTL_SEC=180
COLLECTOR_WEB_THREADS=4
COLLECTOR_HTTP_TIMEOUT_SEC=120
